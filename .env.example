# 비워두면 자동으로 in-memory mock 모드로 동작합니다(로컬 개발용).
#
# 회원가입/로그인/비밀번호 재설정을 배포 환경에서 영구 저장하려면 Supabase를 연결하세요.
#   1) supabase.com 에서 무료 프로젝트 생성
#   2) supabase/schema.sql 의 내용을 SQL Editor에 붙여넣어 실행 (users 테이블 생성)
#   3) Project Settings → API 에서 아래 값 복사
#   4) Vercel → Project → Settings → Environment Variables 에 동일하게 등록 후 재배포
#
# ⚠ 서버에서 회원 데이터를 쓰려면 SERVICE_ROLE 키가 반드시 필요합니다(RLS 우회).
#   ANON 키만 넣으면 읽기/쓰기가 막혀 회원가입이 실패할 수 있습니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Worker (현재는 stub. 실제 연동 시 사용)
GEMINI_API_KEY=
INNGEST_EVENT_KEY=
