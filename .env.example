# 비워두면 자동으로 in-memory mock 모드로 동작합니다(로컬 개발용).
#
# 회원가입/로그인/비밀번호 재설정을 배포 환경에서 영구 저장하려면 Supabase를 연결하세요.
#   1) supabase.com 에서 무료 프로젝트 생성
#   2) supabase/schema.sql 의 내용을 SQL Editor에 붙여넣어 실행 (users 테이블 생성)
#   3) Project Settings → API 에서 아래 값 복사
#   4) Vercel → Project → Settings → Environment Variables 에 동일하게 등록 후 재배포
#
# ⚠ 서버에서 회원 데이터를 쓰려면 SERVICE_ROLE 키가 반드시 필요합니다(RLS 우회).
#   ANON 키만 넣으면 읽기/쓰기가 막혀 회원가입이 실패할 수 있습니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Worker (현재는 stub. 실제 연동 시 사용)
GEMINI_API_KEY=
INNGEST_EVENT_KEY=

# 네이버 지도 (NCP Maps JavaScript API v3)
#   1) console.ncloud.com → Services → AI·NAVER API → Maps → Application 등록
#   2) Web 서비스 URL에 로컬(http://localhost:3000)과 배포 도메인 등록
#   3) 발급된 Client ID(ncpKeyId)를 아래에 입력
# 비워두면 검색 페이지 지도가 데모 그리드로 표시됩니다.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# 네이버 검색 Local Search API (지도 키와 별개!)
#   1) developers.naver.com → Application 등록 → "검색" API 선택
#   2) 발급된 Client ID / Client Secret을 아래에 입력
# 서버에서만 사용되므로 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
# 비워두면 검색 결과가 데모 데이터로 표시됩니다.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
